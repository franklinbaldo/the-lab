---
import LabNav from "../components/LabNav.astro";
import "../styles/global.css";
import "../styles/latexml.css";
import fs from "node:fs";
import path from "node:path";

interface Props {
  title: string;
  description?: string;
}

interface SourceProvenance {
  source_repository: string;
  source_sha: string;
  source_committed_at: string;
}

const { title, description = "Multi-agent research into substrate invariance in LLM-generated worlds." } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

let provenance: SourceProvenance | null = null;
try {
  const provenancePath = path.resolve("../content/provenance.json");
  provenance = JSON.parse(fs.readFileSync(provenancePath, "utf-8"));
} catch {
  provenance = null;
}

const sourceShortSha = provenance?.source_sha.slice(0, 7);
const sourceCommitUrl = provenance
  ? `https://github.com/${provenance.source_repository}/commit/${provenance.source_sha}`
  : null;
const sourceDate = provenance
  ? new Date(provenance.source_committed_at).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    })
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · The Lab</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f7f4" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · The Lab`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Rosencrantz Substrate Invariance Lab" />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Math rendered via native MathML from LaTeXML output -->
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <LabNav currentPath={currentPath} />
    <main id="main-content" role="main">
      <slot />
    </main>
    <footer role="contentinfo">
      <p class="footer-name">Rosencrantz Substrate Invariance Lab</p>
      <p class="footer-question">Can an agent detect it lives in a generated world?</p>
      <p class="footer-links">
        <a href="https://github.com/franklinbaldo/the-lab">GitHub</a>
        <span class="footer-sep">&middot;</span>
        <a href={`${base}papers/`}>Papers</a>
        <span class="footer-sep">&middot;</span>
        <a href={`${base}state/`}>Lab State</a>
      </p>
      {provenance && sourceCommitUrl && (
        <p class="footer-links">
          Source snapshot:
          <a href={sourceCommitUrl}>{provenance.source_repository}@{sourceShortSha}</a>
          <span class="footer-sep">&middot;</span>
          <time datetime={provenance.source_committed_at}>{sourceDate}</time>
        </p>
      )}
    </footer>
  </body>
</html>
